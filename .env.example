# Postgres (Railway Postgres plugin, or a local Postgres for dev)
DATABASE_URL=postgres://user:password@localhost:5432/dulceria

# Railway Storage Bucket (S3-compatible)
STORAGE_ENDPOINT=
STORAGE_REGION=auto
STORAGE_ACCESS_KEY_ID=
STORAGE_SECRET_ACCESS_KEY=
STORAGE_BUCKET_NAME=
STORAGE_PUBLIC_URL=

# Admin session
SESSION_SECRET=replace-with-a-random-string-at-least-32-characters-long
# Generate with: node -e "console.log(require('bcryptjs').hashSync('your-password-here', 10))"
# IMPORTANT: escape every `$` as `\$` — Next.js expands unescaped $VAR
# patterns in .env files, and bcrypt hashes are full of literal `$` signs.
# e.g. $2b$10$abc... must be written as \$2b\$10\$abc...
ADMIN_PASSWORD_HASH=

# Public — sent to the browser, used to build the WhatsApp checkout link
NEXT_PUBLIC_WHATSAPP_PHONE=59173388665
