# Postgres (Railway Postgres plugin in prod). The dev values below match the
# database docker-compose.yml creates.
DATABASE_URL=postgres://dulceria:devpassword@localhost:5433/dulceria

# Railway Storage Bucket (S3-compatible) in prod. The dev values below match
# the MinIO server and bucket docker-compose.yml creates.
STORAGE_ENDPOINT=http://localhost:9010
STORAGE_REGION=auto
STORAGE_ACCESS_KEY_ID=minioadmin
STORAGE_SECRET_ACCESS_KEY=minioadmin123
STORAGE_BUCKET_NAME=dulceria-products
STORAGE_PUBLIC_URL=http://localhost:9010/dulceria-products

# Admin session
SESSION_SECRET=replace-with-a-random-string-at-least-32-characters-long
# Generate with: node -e "console.log(require('bcryptjs').hashSync('your-password-here', 10))"
# IMPORTANT: escape every `$` as `\$` — Next.js expands unescaped $VAR
# patterns in .env files, and bcrypt hashes are full of literal `$` signs.
# e.g. $2b$10$abc... must be written as \$2b\$10\$abc...
ADMIN_PASSWORD_HASH=

# Public — sent to the browser, used to build the WhatsApp checkout link
NEXT_PUBLIC_WHATSAPP_PHONE=59173388665
